<?xml version="1.0"?>
<!-- This is an example transform file for Production environment -->
<!-- It demonstrates how to transform connectionStrings and appSettings -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  
  <!-- Transform connectionStrings -->
  <connectionStrings>
    <!-- Replace the entire connectionString attribute for a specific named connection -->
    <add name="ESRIUK.xxxxxxxxx.PerilsAndProximity.Batch.Properties.Settings.tttConnectionString" 
         connectionString="Data Source=PROD-SQL-SERVER;Initial Catalog=ProductionDB;Persist Security Info=True;User ID=prod_user;Password=#{DB_PASSWORD}#" 
         xdt:Transform="SetAttributes" 
         xdt:Locator="Match(name)"/>
    
    <add name="BatchDataAccess.Properties.Settings.tttConnectionString1" 
         connectionString="Data Source=PROD-SQL-SERVER;Initial Catalog=ProductionDB;Persist Security Info=True;User ID=prod_user;Password=#{DB_PASSWORD}#" 
         xdt:Transform="SetAttributes" 
         xdt:Locator="Match(name)"/>
  </connectionStrings>

  <!-- Transform appSettings -->
  <appSettings>
    <!-- Replace the value attribute for a specific key -->
    <add key="ActiveConnectionString" 
         value="ESRIUK.xxxxxxxxx.PerilsAndProximity.Batch.Properties.Settings.tttConnectionString" 
         xdt:Transform="SetAttributes" 
         xdt:Locator="Match(key)"/>
    
    <!-- You can also add new keys that don't exist in base config -->
    <add key="Environment" 
         value="Production" 
         xdt:Transform="Insert"/>
    
    <!-- Or remove a key if needed -->
    <!-- <add key="DebugMode" xdt:Transform="Remove" xdt:Locator="Match(key)"/> -->
  </appSettings>

  <!-- Example: Transform compilation debug attribute -->
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)"/>
  </system.web>

</configuration>

