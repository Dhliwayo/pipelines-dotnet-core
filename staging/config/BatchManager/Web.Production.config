<?xml version="1.0"?>
<!-- This is an example transform file for Production environment -->
<!-- It demonstrates how to transform connectionStrings and appSettings -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  
  <!-- Transform connectionStrings -->
  <connectionStrings>
    <!-- Replace the entire connectionString attribute for a specific named connection -->
    <add name="ESRIUK.xxxxxxxxx.PerilsAndProximity.Batch.Properties.Settings.tttConnectionString" 
         connectionString="Data Source=#{DB_SERVER}#;Initial Catalog=#{DB_NAME}#;Persist Security Info=True;User ID=#{DB_USER}#;Password=#{DB_PASSWORD}#" 
         xdt:Transform="SetAttributes" 
         xdt:Locator="Match(name)"/>
    
    <add name="BatchDataAccess.Properties.Settings.tttConnectionString1" 
         connectionString="Data Source=#{DB_SERVER}#;Initial Catalog=#{DB_NAME}#;Persist Security Info=True;User ID=#{DB_USER}#;Password=#{DB_PASSWORD}#" 
         xdt:Transform="SetAttributes" 
         xdt:Locator="Match(name)"/>
  </connectionStrings>

  <!-- Transform appSettings -->
  <appSettings>
    <!-- Keep the ActiveConnectionString as is - it references the correct connection -->
    <!-- No need to transform this since it already points to the right connection string name -->
    
    <!-- Add environment-specific setting -->
    <add key="Environment" 
         value="Production" 
         xdt:Transform="InsertIfMissing" 
         xdt:Locator="Match(key)"/>
    
    <!-- Add API endpoint for production -->
    <add key="ApiEndpoint" 
         value="https://api.company.com" 
         xdt:Transform="InsertIfMissing" 
         xdt:Locator="Match(key)"/>
    
    <!-- Add database timeout for Production (longer timeout) -->
    <add key="DatabaseTimeout" 
         value="60" 
         xdt:Transform="InsertIfMissing" 
         xdt:Locator="Match(key)"/>
    
    <!-- Add production-specific logging level -->
    <add key="LogLevel" 
         value="Warning" 
         xdt:Transform="InsertIfMissing" 
         xdt:Locator="Match(key)"/>
  </appSettings>

  <!-- Example: Transform compilation debug attribute -->
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)"/>
  </system.web>

</configuration>

