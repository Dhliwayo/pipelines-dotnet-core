<?xml version="1.0"?>
<!-- This is an example transform file for PreProd environment -->
<!-- It demonstrates how to transform connectionStrings and appSettings -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  
  <!-- Transform connectionStrings -->
  <connectionStrings>
    <!-- Replace the entire connectionString attribute for a specific named connection -->
    <add name="ESRIUK.xxxxxxxxx.PerilsAndProximity.Batch.Properties.Settings.tttConnectionString" 
         connectionString="Data Source=#{DB_SERVER}#;Initial Catalog=#{DB_NAME}#;Persist Security Info=True;User ID=#{DB_USER}#;Password=#{DB_PASSWORD}#" 
         xdt:Transform="SetAttributes" 
         xdt:Locator="Match(name)"/>
    
    <add name="BatchDataAccess.Properties.Settings.tttConnectionString1" 
         connectionString="Data Source=#{DB_SERVER}#;Initial Catalog=#{DB_NAME}#;Persist Security Info=True;User ID=#{DB_USER}#;Password=#{DB_PASSWORD}#" 
         xdt:Transform="SetAttributes" 
         xdt:Locator="Match(name)"/>
  </connectionStrings>

  <!-- Transform appSettings -->
  <appSettings>
    <!-- Replace the value attribute for a specific key -->
    <add key="ActiveConnectionString" 
         value="ESRIUK.xxxxxxxxx.PerilsAndProximity.Batch.Properties.Settings.tttConnectionString" 
         xdt:Transform="SetAttributes" 
         xdt:Locator="Match(key)"/>
    
    <!-- Add environment-specific setting -->
    <add key="Environment" 
         value="PreProduction" 
         xdt:Transform="Insert"/>
    
    <!-- Add API endpoint that might be different per environment -->
    <add key="ApiEndpoint" 
         value="https://preprod-api.example.com" 
         xdt:Transform="InsertIfMissing" 
         xdt:Locator="Match(key)"/>
  </appSettings>

  <!-- Keep debug on for PreProd -->
  <system.web>
    <compilation debug="true" xdt:Transform="SetAttributes(debug)"/>
  </system.web>

</configuration>

