/*
Purpose:
- Create a copy of a given table
- TRUNCATE the original table (mandatory; fail if blocked by FKs/permissions)
- Reload data from the copy while REGENERATING new IDs starting from 1 for the specified ID column

Usage:
- Set @SchemaName, @TableName, @IdColumn. Optionally @CopyTableName.
- @IdColumn does NOT need to be an identity column; new IDs will be generated sequentially from 1.
*/

SET NOCOUNT ON;
SET XACT_ABORT ON;

DECLARE
    @SchemaName     sysname = N'dbo',
    @TableName      sysname = N'YourTable',
    @IdColumn       sysname = N'Id',        -- ID column to regenerate (NOT identity)
    @CopyTableName  sysname = NULL;         -- NULL => <TableName>_Copy

DECLARE
    @QualifiedTable nvarchar(300),
    @QualifiedCopy  nvarchar(300),
    @ColsForInsert  nvarchar(max),
    @ColsWithNewId  nvarchar(max),
    @TempIdColumn   sysname = N'__TempRowNum__',
    @sql            nvarchar(max);

-- Resolve names
SET @QualifiedTable = QUOTENAME(@SchemaName) + N'.' + QUOTENAME(@TableName);
IF @CopyTableName IS NULL
    SET @CopyTableName = @TableName + N'_Copy';
SET @QualifiedCopy  = QUOTENAME(@SchemaName) + N'.' + QUOTENAME(@CopyTableName);

-- Validate table exists
IF OBJECT_ID(@QualifiedTable, 'U') IS NULL
BEGIN
    RAISERROR('Table %s does not exist.', 16, 1, @QualifiedTable);
    RETURN;
END

-- Validate ID column exists on table
IF NOT EXISTS (
    SELECT 1
    FROM sys.columns c
    JOIN sys.objects o ON o.object_id = c.object_id
    JOIN sys.schemas s ON s.schema_id = o.schema_id
    WHERE s.name = @SchemaName AND o.name = @TableName AND c.name = @IdColumn
)
BEGIN
    RAISERROR('Column %s does not exist on %s.', 16, 1, @IdColumn, @QualifiedTable);
    RETURN;
END

BEGIN TRY
    BEGIN TRAN;

    -- Drop existing copy table if present
    IF OBJECT_ID(@QualifiedCopy, 'U') IS NOT NULL
    BEGIN
        SET @sql = N'DROP TABLE ' + @QualifiedCopy + N';';
        EXEC sp_executesql @sql;
    END

    -- Create copy table with current data INCLUDING a new identity column for row numbering
    SET @sql = N'
        SELECT 
            IDENTITY(INT, 1, 1) AS ' + QUOTENAME(@TempIdColumn) + N',
            *
        INTO ' + @QualifiedCopy + N'
        FROM ' + @QualifiedTable + N';';
    EXEC sp_executesql @sql;

    -- Build column list for insert EXCLUDING:
    -- - ID column (@IdColumn) - we'll regenerate this
    -- - computed columns
    -- - rowversion/timestamp columns (system_type_id = 189)
    -- Using FOR XML PATH for SQL Server 2012+ compatibility
    SELECT @ColsForInsert = STUFF((
        SELECT N',' + QUOTENAME(c.name)
        FROM sys.columns c
        JOIN sys.objects o ON o.object_id = c.object_id
        JOIN sys.schemas s ON s.schema_id = o.schema_id
        WHERE s.name = @SchemaName
          AND o.name = @TableName
          AND c.name <> @IdColumn
          AND c.is_computed = 0
          AND c.system_type_id <> 189
        ORDER BY c.column_id
        FOR XML PATH(''), TYPE
    ).value('.', 'NVARCHAR(MAX)'), 1, 1, '');

    IF @ColsForInsert IS NULL OR LEN(@ColsForInsert) = 0
    BEGIN
        RAISERROR('No insertable columns found after excluding ID/computed/rowversion.', 16, 1);
        ROLLBACK TRAN;
        RETURN;
    END

    -- Build column list WITH new ID: temp identity column AS the ID column, plus other columns
    SET @ColsWithNewId = QUOTENAME(@TempIdColumn) + N' AS ' + QUOTENAME(@IdColumn) + N',' + @ColsForInsert;

    -- TRUNCATE is mandatory. Fail if blocked (e.g., FKs) or not permitted.
    BEGIN TRY
        SET @sql = N'TRUNCATE TABLE ' + @QualifiedTable + N';';
        EXEC sp_executesql @sql;
    END TRY
    BEGIN CATCH
        DECLARE
            @err int = ERROR_NUMBER(),
            @sev int = ERROR_SEVERITY(),
            @state int = ERROR_STATE(),
            @line int = ERROR_LINE(),
            @msg nvarchar(2048) = ERROR_MESSAGE();

        -- Rollback and rethrow with clear context
        IF XACT_STATE() <> 0 ROLLBACK TRAN;
        RAISERROR('TRUNCATE failed for %s. Likely due to foreign keys or permissions. Details: %s (Err %d, Sev %d, State %d, Line %d)',
                  16, 1, @QualifiedTable, @msg, @err, @sev, @state, @line);
        RETURN;
    END CATCH

    -- Reload with new IDs: use temp identity column as new ID values starting from 1
    SET @sql = N'
        INSERT INTO ' + @QualifiedTable + N' (' + QUOTENAME(@IdColumn) + N',' + @ColsForInsert + N')
        SELECT ' + @ColsWithNewId + N'
        FROM ' + @QualifiedCopy + N'
        ORDER BY ' + QUOTENAME(@TempIdColumn) + N';';
    EXEC sp_executesql @sql;

    COMMIT TRAN;
    PRINT 'Success: Data reloaded with new sequential IDs starting from 1 for ' + @QualifiedTable + N'.';
END TRY
BEGIN CATCH
    IF XACT_STATE() <> 0 ROLLBACK TRAN;

    DECLARE
        @err2 int = ERROR_NUMBER(),
        @sev2 int = ERROR_SEVERITY(),
        @state2 int = ERROR_STATE(),
        @line2 int = ERROR_LINE(),
        @msg2 nvarchar(2048) = ERROR_MESSAGE();

    RAISERROR('Failed: %s (Err %d, Sev %d, State %d, Line %d)', 16, 1, @msg2, @err2, @sev2, @state2, @line2);
END CATCH